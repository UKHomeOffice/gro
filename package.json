{
  "name": "GRO",
  "version": "1.0.1",
  "main": "server.js",
  "description": "The General Register Office DSP form",
  "license": "GPL-2.0",
  "engines": {
    "node": ">=24.15.0 <25.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/UKHomeOffice/gro/"
  },
  "readme": "./README.md",
  "scripts": {
    "start": "node server.js",
    "start:dev": "NODE_ENV=development hof-build watch --env",
    "test": "npm run test:lint",
    "bddgen": "bddgen",
    "test:e2e": "bddgen && playwright test",
    "test:e2e:headed": "bddgen && playwright test --headed",
    "test:e2e:debug": "bddgen && playwright test --debug",
    "test:e2e:report": "playwright show-report",
    "test:integration": "NODE_ENV=development _mocha \"test/_integration/**/*.spec.js\" -r dotenv/config --exit",
    "test:lint": "eslint . --config ./node_modules/eslint-config-hof/default.js",
    "build": "hof-build",
    "postinstall": "yarn run build"
  },
  "author": "HomeOffice",
  "dependencies": {
    "accessible-autocomplete": "^3.0.1",
    "@cucumber/cucumber": "^13.0.0",
    "hof": "~24.4.0",
    "homeoffice-countries": "^0.2.0",
    "lodash": "^4.18.1",
    "moment": "^2.30.1"
  },
  "devDependencies": {
    "@playwright/test": "1.60.0",
    "@types/node": "^20.19.0",
    "chai": "^6.2.2",
    "dotenv": "^17.4.2",
    "eslint": "^8.57.0",
    "eslint-config-hof": "^1.0.4",
    "jsdom": "^29.1.1",
    "mocha": "^11.7.6",
    "playwright-bdd": "^9.2.0",
    "sinon": "^22.0.0",
    "sinon-chai": "^4.0.1",
    "supertest": "^7.2.2",
    "supertest-session": "^5.0.1"
  },
  "mocha": {
    "reporter": "spec",
    "require": "test/setup.js",
    "recursive": "true",
    "timeout": "6000"
  },
  "resolutions": {
    "serialize-javascript": "^7.0.7"
  }
}
